# Contentful credentials
# Please replace the placeholder values below with your actual Contentful space ID and access token
# https://www.contentful.com/developers/docs/references/content-delivery-api/

# To find your space ID and access token:
# 1. Log in to your Contentful account
# 2. Go to your space settings
# 3. Navigate to the "API keys" section
# 4. Create a new API key or use an existing one
# 5. Copy the "Space ID" and "Content Delivery API - access token" values

CONTENTFUL_SPACE_ID="id_here"
CONTENTFUL_ACCESS_TOKEN="token_here"

# YouTube API key
# https://developers.google.com/youtube/v3/docs

# To get a YouTube API key:
# Go to the Google Developers Console (https://console.developers.google.com/)
# Create a new project or select an existing one
# Enable the YouTube Data API v3
# Create credentials (API key)
# Add the API key to your .env file:
NEXT_PUBLIC_YOUTUBE_API_KEY="key_here"
